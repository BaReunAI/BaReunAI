# =========================================================
# 로컬 개발용 환경변수 템플릿
# =========================================================
# 사용법:
#   1) 이 파일을 '.dev.vars' 로 복사
#        cp .dev.vars.example .dev.vars
#   2) 아래 값들을 실제 값으로 채워넣기
#   3) .dev.vars 는 git에 커밋되지 않음 (.gitignore 에 포함)
#
# 배포용(프로덕션)은 wrangler secret 으로 따로 등록:
#   npx wrangler pages secret put RESEND_API_KEY --project-name <프로젝트명>
# =========================================================

# Resend API 키 (https://resend.com/api-keys 에서 발급)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 문의를 받을 이메일 (박사님 이메일)
CONTACT_TO_EMAIL=ResearchAi@naver.com

# 발신자 (도메인 인증 전에는 onboarding@resend.dev 사용)
# 커스텀 도메인 인증 후에는 'contact@yourdomain.com' 같은 형식으로 교체
CONTACT_FROM_EMAIL=바른AI <onboarding@resend.dev>
